{
  "expo": {
    "name": "潮環占い",
    "slug": "chokan-uranai",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/art/app-icon.png",
    "backgroundColor": "#10172a",
    "ios": {
      "bundleIdentifier": "jp.chokanuranai.app",
      "supportsTablet": true,
      "requireFullScreen": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/art/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-iap",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#10172a",
          "image": "./assets/art/app-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "jp.chokanuranai.app.widgets",
          "groupIdentifier": "group.jp.chokanuranai.app",
          "widgets": [
            {
              "name": "ChokanWidget",
              "displayName": "潮環占い",
              "description": "今日の海と、あなたのタイプのキャラクター",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge"
                ],
                "initialLayout": "widgets/chokanWidget.tsx"
              }
            }
          ]
        }
      ]
    ],
    "scheme": "chokanuranai",
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "jp.chokanuranai.app.widgets",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.jp.chokanuranai.app"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "43896fc9-176b-4ccc-9062-4a8141f3baad"
      }
    },
    "owner": "obana.h"
  }
}
